<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.6"
            android:layout_margin="5dp"
            android:background="@drawable/card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btConnect"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@null"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:tint="@color/label"
                android:contentDescription="@string/action_connect"
                app:srcCompat="@drawable/ic_plug" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.10"
                android:text="@string/status_disconnected"
                android:textColor="@color/labelSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/card"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btReadFaults"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@null"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/label"
                    android:contentDescription="@string/action_read_faults"
                    app:srcCompat="@drawable/ic_list" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/label_faults"
                    android:textColor="@color/labelSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:background="@drawable/card"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btClearFaults"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@null"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/label"
                    android:contentDescription="@string/action_clear_faults"
                    app:srcCompat="@drawable/ic_erase" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/label_erase"
                    android:textColor="@color/labelSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:layout_margin="5dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.10"
                android:text="@string/vehicle"
                android:textColor="@color/labelTertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="@string/dash_placeholder"
                android:textColor="@color/labelSecondary"
                android:textSize="12sp" />
        
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.10"
                android:text="@string/faults_title"
                android:textColor="@color/labelTertiary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFaults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:text="@string/faults_unknown"
                android:textColor="@color/labelTertiary"
                android:textSize="12sp" />
</LinearLayout>

        <TextView
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.10"
            android:text="@string/journal"
            android:textColor="@color/labelTertiary"
            android:textSize="11sp"
            android:textStyle="bold" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/labelSecondary"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
