<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.mooo.hairyone.td5tester.views.GaugeView
            android:id="@+id/gPOWER_BALANCE_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:gaugeMin="-15"
            app:gaugeMax="15"
            app:gaugeDecimals="1"
            app:gaugeCaption="INJ 1" />

        <com.mooo.hairyone.td5tester.views.GaugeView
            android:id="@+id/gPOWER_BALANCE_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:gaugeMin="-15"
            app:gaugeMax="15"
            app:gaugeDecimals="1"
            app:gaugeCaption="INJ 2" />

        <com.mooo.hairyone.td5tester.views.GaugeView
            android:id="@+id/gPOWER_BALANCE_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:gaugeMin="-15"
            app:gaugeMax="15"
            app:gaugeDecimals="1"
            app:gaugeCaption="INJ 3" />

        <com.mooo.hairyone.td5tester.views.GaugeView
            android:id="@+id/gPOWER_BALANCE_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:gaugeMin="-15"
            app:gaugeMax="15"
            app:gaugeDecimals="1"
            app:gaugeCaption="INJ 4" />

        <com.mooo.hairyone.td5tester.views.GaugeView
            android:id="@+id/gPOWER_BALANCE_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:gaugeMin="-15"
            app:gaugeMax="15"
            app:gaugeDecimals="1"
            app:gaugeCaption="INJ 5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvConditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
            android:text="@string/inj_waiting"
            android:textColor="@color/labelTertiary"
            android:textSize="12sp"
            android:textStyle="bold" />


    </LinearLayout>
</LinearLayout>
